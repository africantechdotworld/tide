{% extends request.ajax ? "layout_blank.html.twig" : "layout_default.html.twig" %}

{% import "macro_functions.html.twig" as mf %}

{% block meta_title %}{{ order.title }}{% endblock %}

{% set addons = client.order_addons({ "id": order.id }) %}

{% block body_class %}order-manage{% endblock %}
{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{{ 'order/service' | link}}">{{ 'Services'|trans }}</a></li>
<li class="breadcrumb-item active" aria-current="page">{{ order.title }}</li>
{% endblock %}

{% set service_partial = "mod_service" ~ order.service_type ~ "_manage.html.twig" %}
{% set upgradables = client.order_upgradables({ 'id': order.id }) %}

{% block head %}
    {{ mf.wysiwyg('.editor-textarea') }}
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            {# Order info #}
            <div class="card mb-4">
                <div class="card-header py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="mb-1">{{ 'Service details'|trans }}</h1>
                            <span class="small text-secondary">{{ 'All information about your service'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="datagrid">
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Order'|trans }}</div>
                        <div class="datagrid-content">#{{ order.id }}</div>
                      </div>
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Product name'|trans }}</div>
                        <div class="datagrid-content"><strong>{{ order.title }}</strong></div>
                      </div>
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Payment amount'|trans }}</div>
                        <div class="datagrid-content">{{ order.total|money(order.currency) }}</div>
                      </div>
                      {% if order.period %}
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Billing cycle'|trans }}</div>
                        <div class="datagrid-content">{{ order.period|period_title }}</div>
                      </div>
                      {% endif %}
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Order status'|trans }}</div>
                        <div class="datagrid-content"><span class="badge {% if order.status == 'active' %}bg-success text-success-fg{% elseif order.status == 'pending_setup' %}bg-warning text-warning-fg{% elseif order.status == 'failed_setup' or order.status == 'suspended' or order.status == 'failed_renew' %}bg-danger text-danger-fg{% elseif order.status == 'canceled' %}bg-secondary text-secondary-fg{% endif %}">{{ mf.status_name(order.status) }}</span></div>
                      </div>
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Order created'|trans }}</div>
                        <div class="datagrid-content">{{ order.created_at|date('Y-m-d H:i:s') }}</div>
                      </div>
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Activated at'|trans }}</div>
                        <div class="datagrid-content">{% if order.activated_at %}{{ order.activated_at|date('Y-m-d H:i:s') }}{% else %}-{% endif %}</div>
                      </div>
                      {% if order.period %}
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Renewal date'|trans }} {% if order.expires_at %} in {{ order.expires_at|daysleft }} day(s) {% endif %}</div>
                        <div class="datagrid-content">{% if order.expires_at %}{{ order.expires_at|date('Y-m-d H:i:s') }}{% else %}-{% endif %}</div>
                      </div>
                      {% endif %}
                      {% if order.notes %}
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Order notes'|trans }}</div>
                        <div class="datagrid-content">{{ order.notes|markdown }}</div>
                      </div>
                      {% endif %}
                      {% if order.active_tickets > 0 %}
                      <div class="datagrid-item">
                        <div class="datagrid-title">{{ 'Active support tickets'|trans }}</div>
                        <div class="datagrid-content"><div class="num"><a href="{{ 'support'|link }}" class="redNum">{{ order.active_tickets }}</a></div></div>
                      </div>
                      {% endif %}
                    </div>
                </div>
                <div class="card-footer">
                    {% if order.period and order.status != 'failed_renew' %}
                        <button class="btn btn-primary btn-sm" type="button" id="renewal-button">{{ 'Renew now'|trans }}</button>
                    {% endif %}
                    {% if upgradables %}
                        <button class="btn btn-success btn-sm" type="button" id="request-upgrade" data-bs-toggle="modal" data-bs-target="#upgrade-request-modal">{{ 'Request Upgrade'|trans }}</button>
                    {% endif %}
                    <button class="btn btn-info btn-sm" type="button" id="open-ticket" data-bs-toggle="modal" data-bs-target="#open-ticket-modal">{{ 'Open ticket'|trans }}</button>
                    {% if order.status == 'active' %}
                        <button class="btn btn-danger btn-sm" type="button" id="request-cancel" data-bs-toggle="modal" data-bs-target="#cancel-request-modal">{{ 'Request cancellation'|trans }}</button>
                    {% endif %}
                </div>
            </div>

            {# VPS Management Card #}
            {% set vmid = null %}
            {% set vpsid = "VH-xxxx" %}
            {% if 'VMID:' in order.notes %}
                {% set vmid = order.notes|split('VMID: ')[1]|split('\n')[0]|trim %}
                {% if 'VPS ID:' in order.notes %}
                   {% set vpsid = order.notes|split('VPS ID: ')[1]|split('\n')[0]|trim %}
                {% endif %}
            {% endif %}

            {% if vmid %}
            <div class="card mb-4 border-primary shadow-sm" id="vps-panel">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon me-2" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 4m0 3a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3z" /><path d="M3 12m0 3a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v2a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3z" /><path d="M7 8l0 .01" /><path d="M7 16l0 .01" /></svg>
                        VPS Remote Management
                    </h5>
                    <span id="vps-status-badge" class="badge bg-light text-primary font-weight-bold">Checking...</span>
                </div>
                <div class="card-body">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary-lt p-3 rounded-3 me-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon text-primary fs-2" width="32" height="32" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 12l0 .01" /><path d="M14.828 9.172a4 4 0 0 1 0 5.656" /><path d="M17.657 6.343a8 8 0 0 1 0 11.314" /><path d="M9.172 9.172a4 4 0 0 0 0 5.656" /><path d="M6.343 6.343a8 8 0 0 0 0 11.314" /></svg>
                                </div>
                                <div>
                                    <div class="text-secondary small">System ID</div>
                                    <div class="h3 mb-2">{{ vpsid }}</div>
                                    
                                    <!-- Dynamic IP & SSH Section -->
                                    <div class="mt-2 text-muted small" style="display:none;" id="spec-login-box">
                                        <div class="d-flex align-items-center mb-1">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon text-secondary me-1" width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 12l0 .01"/><path d="M14.828 9.172a4 4 0 0 1 0 5.656"/><path d="M17.657 6.343a8 8 0 0 1 0 11.314"/><path d="M9.172 9.172a4 4 0 0 0 0 5.656"/><path d="M6.343 6.343a8 8 0 0 0 0 11.314"/></svg>
                                            <strong>IP Address:</strong>&nbsp;<span id="spec-ip">Loading...</span>
                                        </div>
                                        <div class="d-flex align-items-center">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon text-secondary me-1" width="16" height="16" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 4h4l3 3h7a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2" /></svg>
                                            <strong>SSH:</strong>&nbsp;<code id="spec-ssh">Loading...</code>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex gap-2">
                                <button id="btn-vps-start" class="btn btn-sm btn-success vps-action" data-action="start" disabled>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon me-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 4v16l13 -8z" /></svg>
                                    Start
                                </button>
                                <button id="btn-vps-reboot" class="btn btn-sm btn-warning vps-action" data-action="reboot" disabled>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon me-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M20 11a8.1 8.1 0 0 0 -15.5 -2m-.5 -4v4h4" /><path d="M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4" /></svg>
                                    Reboot
                                </button>
                                <button id="btn-vps-stop" class="btn btn-sm btn-danger vps-action" data-action="stop" disabled>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="icon me-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 5m0 2a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2z" /></svg>
                                    Stop
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6 border-start-md">
                            <div class="mb-3">
                                <label class="form-label small text-secondary font-weight-bold">Security: Reset Root Password</label>
                                <div class="input-group">
                                    <input type="password" id="new-vps-password" class="form-control form-control-sm" placeholder="Type new password">
                                    <button class="btn btn-sm btn-light border border-start-0" type="button" id="btn-toggle-pw" title="Show password">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon text-secondary m-0" width="18" height="18" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                                    </button>
                                    <button class="btn btn-sm btn-primary ms-1" type="button" id="btn-reset-pw">Update Password</button>
                                </div>
                                <div class="form-hint small mt-1">Applying a new password will instantly sync with your system.</div>
                            </div>
                        </div>
                    </div>
                    
                    <hr class="my-4">
                    
                    <div class="row row-cards" id="vps-specs-grid" style="opacity: 0.5;">
                        <div class="col-6 col-sm-3">
                            <div class="card card-sm shadow-none border">
                                <div class="card-body d-flex align-items-center">
                                    <span class="bg-blue-lt text-blue avatar avatar-sm me-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 5m0 1a1 1 0 0 1 1 -1h12a1 1 0 0 1 1 1v12a1 1 0 0 1 -1 1h-12a1 1 0 0 1 -1 -1z" /><path d="M9 9h6v6h-6z" /><path d="M3 10h2" /><path d="M3 14h2" /><path d="M10 3v2" /><path d="M14 3v2" /><path d="M21 10h-2" /><path d="M21 14h-2" /><path d="M14 21v-2" /><path d="M10 21v-2" /></svg>
                                    </span>
                                    <div>
                                        <div class="font-weight-medium small">CPU Cores</div>
                                        <div class="text-secondary small" id="spec-cpu">Loading...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="card card-sm shadow-none border">
                                <div class="card-body d-flex align-items-center">
                                    <span class="bg-green-lt text-green avatar avatar-sm me-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 6m-8 0a8 3 0 1 0 16 0a8 3 0 1 0 -16 0" /><path d="M4 6v6a8 3 0 0 0 16 0v-6" /><path d="M4 12v6a8 3 0 0 0 16 0v-6" /></svg>
                                    </span>
                                    <div>
                                        <div class="font-weight-medium small">Memory</div>
                                        <div class="text-secondary small" id="spec-ram">Loading...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="card card-sm shadow-none border">
                                <div class="card-body d-flex align-items-center">
                                    <span class="bg-orange-lt text-orange avatar avatar-sm me-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 14m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v2a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" /><path d="M4 6m0 2a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v2a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2z" /><path d="M16 16l.01 0" /><path d="M16 8l.01 0" /></svg>
                                    </span>
                                    <div>
                                        <div class="font-weight-medium small">Disk space</div>
                                        <div class="text-secondary small" id="spec-disk">Loading...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="card card-sm shadow-none border">
                                <div class="card-body d-flex align-items-center">
                                    <span class="bg-purple-lt text-purple avatar avatar-sm me-2">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 21a9 9 0 0 1 -9 -9h-3" /><path d="M12 21a9 9 0 0 0 9 -9h3" /><path d="M12 3a9 9 0 0 1 9 9h3" /><path d="M12 3a9 9 0 0 0 -9 9h-3" /><path d="M12 3v3" /><path d="M12 21v-3" /><path d="M3 12h3" /><path d="M21 12h-3" /><path d="M12 15a3 3 0 1 0 0 -6a3 3 0 0 0 0 6z" /></svg>
                                    </span>
                                    <div>
                                        <div class="font-weight-medium small">Operating System</div>
                                        <div class="text-secondary small" id="spec-os" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Loading...</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div id="vps-usage-grid" style="display:none; margin-top: 2rem;">
                        <h6 class="text-uppercase text-muted border-bottom pb-2 mb-3" style="letter-spacing: 0.1em; font-size: 0.75rem;">Live Resource Usage</h6>
                        <div class="row align-items-center mb-2">
                            <div class="col-4 col-sm-2 text-secondary small font-weight-medium">CPU Usage</div>
                            <div class="col">
                                <div class="progress progress-sm">
                                    <div class="progress-bar bg-blue" id="bar-cpu" style="width: 0%" role="progressbar"></div>
                                </div>
                            </div>
                            <div class="col-auto text-secondary small font-weight-medium" style="width: 50px; text-align: right;" id="text-cpu">0%</div>
                        </div>
                        <div class="row align-items-center">
                            <div class="col-4 col-sm-2 text-secondary small font-weight-medium">Memory Usage</div>
                            <div class="col">
                                <div class="progress progress-sm">
                                    <div class="progress-bar bg-green" id="bar-mem" style="width: 0%" role="progressbar"></div>
                                </div>
                            </div>
                            <div class="col-auto text-secondary small font-weight-medium" style="width: 50px; text-align: right;" id="text-mem">0%</div>
                        </div>
                        <div class="row align-items-center mt-2">
                            <div class="col-4 col-sm-2 text-secondary small font-weight-medium">Disk Usage</div>
                            <div class="col">
                                <div class="progress progress-sm">
                                    <div class="progress-bar bg-orange" id="bar-disk" style="width: 0%" role="progressbar"></div>
                                </div>
                            </div>
                            <div class="col-auto text-secondary small font-weight-medium" style="width: 50px; text-align: right;" id="text-disk">0%</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light py-2 small text-muted text-center">
                    <svg xmlns="http://www.w3.org/2000/svg" class="icon me-1" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" /><path d="M12 9h.01" /><path d="M11 12h1v4h1" /></svg> Please allow up to 10 seconds for service actions to sync with our infrastructure.
                </div>
            </div>

            <script>
            document.addEventListener("DOMContentLoaded", function() {
                const vmid = "{{ vmid }}";
                const apiProxy = "/vps-proxy.php";
                const statusBadge = document.getElementById('vps-status-badge');
                
                const btnStart  = document.getElementById('btn-vps-start');
                const btnReboot = document.getElementById('btn-vps-reboot');
                const btnStop   = document.getElementById('btn-vps-stop');

                // Update Status & Toggle Buttons
                function updateStatus() {
                    fetch(`${apiProxy}?vmid=${vmid}`)
                        .then(r => r.json())
                        .then(data => {
                            const status = data.status.toLowerCase();
                            statusBadge.textContent = status.toUpperCase();
                            
                            if (status === 'running') {
                                statusBadge.className = "badge bg-success text-white";
                                btnStart.disabled  = true;
                                btnReboot.disabled = false;
                                btnStop.disabled   = false;
                                
                                const cpuPct = Math.round((data.cpu || 0) * 100) || 0;
                                const memPct = data.maxmem ? Math.round((data.mem / data.maxmem) * 100) : 0;
                                const diskPct = data.maxdisk ? Math.round((data.disk / data.maxdisk) * 100) : 0;
                                
                                document.getElementById('bar-cpu').style.width = cpuPct + '%';
                                document.getElementById('text-cpu').textContent = cpuPct + '%';
                                
                                document.getElementById('bar-mem').style.width = memPct + '%';
                                document.getElementById('text-mem').textContent = memPct + '%';
                                
                                document.getElementById('bar-disk').style.width = diskPct + '%';
                                document.getElementById('text-disk').textContent = diskPct + '%';
                                
                                document.getElementById('vps-usage-grid').style.display = 'block';
                            } else {
                                statusBadge.className = "badge bg-warning text-white";
                                btnStart.disabled  = false;
                                btnReboot.disabled = true;
                                btnStop.disabled   = true;
                                document.getElementById('vps-usage-grid').style.display = 'none';
                            }
                        })
                        .catch(() => { statusBadge.textContent = "OFFLINE"; });
                }

                // Fetch Specs from DB
                function fetchSpecs() {
                    fetch(`${apiProxy}?vmid=${vmid}&action=details`)
                        .then(r => r.json())
                        .then(data => {
                            if(data.status !== "error") {
                                document.getElementById('spec-cpu').textContent = data.cpu;
                                document.getElementById('spec-ram').textContent = data.ram;
                                document.getElementById('spec-disk').textContent = data.disk;
                                document.getElementById('spec-os').textContent = data.os;
                                document.getElementById('vps-specs-grid').style.opacity = "1";
                                
                                document.getElementById('spec-ip').textContent = data.ip;
                                document.getElementById('spec-ssh').textContent = `ssh root@${data.ip}`;
                                document.getElementById('spec-login-box').style.display = "block";
                            }
                        });
                }

                updateStatus();
                fetchSpecs();
                setInterval(updateStatus, 15000);

                // Power Actions
                document.querySelectorAll('.vps-action').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const action = this.dataset.action;
                        if (!confirm(`Are you sure you want to ${action} this VPS?`)) return;
                        
                        document.querySelectorAll('.vps-action').forEach(b => b.disabled = true);
                        fetch(apiProxy, {
                            method: 'POST',
                            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                            body: `vmid=${vmid}&action=${action}`
                        }).then(() => {
                            FOSSBilling.message(`Request to ${action} VPS has been sent.`);
                            setTimeout(updateStatus, 8000);
                        });
                    });
                });

                // Reset Password
                document.getElementById('btn-toggle-pw').addEventListener('click', function() {
                    const pwInput = document.getElementById('new-vps-password');
                    if (pwInput.type === "password") {
                        pwInput.type = "text";
                    } else {
                        pwInput.type = "password";
                    }
                });
                
                document.getElementById('btn-reset-pw').addEventListener('click', function() {
                    const pw = document.getElementById('new-vps-password').value;
                    if(!pw) { alert("Please enter a new password"); return; }
                    if(!confirm("This will overwrite the current root password. Continue?")) return;

                    const btn = this;
                    btn.disabled = true;
                    fetch(apiProxy, {
                        method: 'POST',
                        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                        body: `vmid=${vmid}&action=reset-pw&password=${encodeURIComponent(pw)}`
                    }).then(() => {
                        FOSSBilling.message("Root password updated successfully");
                        document.getElementById('new-vps-password').value = "";
                        btn.disabled = false;
                    });
                });
            });
            </script>
            {% endif %}

            {# Service management #}
            {% if guest.system_template_exists({ 'file': service_partial }) %}
                {% set service = client.order_service({ 'id': order.id }) %}
                {{ include(service_partial, { 'order': order, 'service': service }) }}
            {% endif %}

            {# Order addons #}
            {% if order.group_master == 1 and addons|length > 0 %}
            <div class="card mb-4">
                <div class="card-header py-3 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="mb-1">{{ 'Addons'|trans }}</h1>
                            <span class="small text-secondary">{{ 'Addons you have ordered with this service'|trans }}</span>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                        <table class="table table-hover table-bordered table-sm">
                            <thead>
                            <tr>
                                <th>{{ 'Product/Service'|trans }}</th>
                                <th>{{ 'Price'|trans }}</th>
                                <th>{{ 'Billing Cycle'|trans }}</th>
                                <th>{{ 'Next due date'|trans }}</th>
                                <th>{{ 'Status'|trans }}</th>
                                <th>{{ 'Actions'|trans }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for i, addon in addons %}
                                <tr>
                                    <td>{{ addon.title }}</td>
                                    <td>{{ addon.total|money(addon.currency) }}</td>
                                    <td>{{ addon.period|period_title }}</td>
                                    <td>{% if addon.expires_at %}{{ addon.expires_at|format_date }}{% else %}-{% endif %}</td>
                                    <td>
                                        <span class="badge {% if addon.status == 'active' %}bg-success{% elseif addon.status == 'pending_setup' %}bg-warning{% endif %}">{{ mf.status_name(addon.status) }}</span>
                                    </td>
                                    <td class="actions">
                                        <a class="btn btn-outline-primary btn-sm" href="{{ '/order/service/manage'|link }}/{{ addon.id }}">{{ 'Manage'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            {% endif %}

            <div class="modal fade" id="cancel-request-modal" tabindex="-1" role="dialog" aria-labelledby="cancel-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit cancellation request'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="cancel-request-form" class="request-cancellation">
                            <div class="modal-body">
                                <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <input type="hidden" name="rel_task" value="cancel">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" id="subject" value="{{ request.subject|e }}" required/>
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">{{ 'Reason'|trans }}</label>
                                    <textarea class="form-control" id="content" name="content" rows="5" required>{{ request.content|e }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-danger">{{ 'Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="open-ticket-modal" tabindex="-1" role="dialog" aria-labelledby="ticket-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit new support ticket'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="open-ticket-form" class="open-ticket">
                            <div class="modal-body">
                                <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" value="{{ request.subject|e }}" required/>
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">{{ 'Message'|trans }}</label>
                                    <textarea class="editor-textarea form-control" id="content" name="content" rows="5" required>{{ request.content|e }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary">{{ 'Open ticket'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="upgrade-request-modal" tabindex="-1" role="dialog" aria-labelledby="upgrade-modal" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Submit upgrade request'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <form action="" method="post" id="upgrade-request-form" class="request-upgrade">
                            <div class="modal-body">
                                <input type="hidden" name="CSRFToken" value="{{ CSRFToken }}"/>
                                <input type="hidden" name="rel_type" value="order">
                                <input type="hidden" name="rel_id" value="{{ order.id }}">
                                <input type="hidden" name="rel_task" value="upgrade">
                                <div class="mb-3">
                                    <label for="support-helpdesk-id" class="form-label">{{ 'Help desk'|trans }}</label>
                                    {{ mf.selectbox('support_helpdesk_id', client.support_helpdesk_get_pairs, request.support_helpdesk_id, 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="subject" class="form-label">{{ 'Subject'|trans }}</label>
                                    <input class="form-control" type="text" name="subject" id="subject" value="{{ request.subject|e }}" required />
                                </div>
                                <div class="mb-3">
                                    <label for="rel_new_value" class="form-label">{{ 'Upgrade to'|trans }}</label>
                                    {{ mf.selectbox('rel_new_value', upgradables, '', 1) }}
                                </div>
                                <div class="mb-3">
                                    <label for="content" class="form-label">{{ 'Notes'|trans }}</label>
                                    <textarea id="content" name="content" rows="5" required class="form-control" placeholder="Your comment">{{ 'I would like to upgrade'|trans }} {{ order.title }}</textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="submit" class="btn btn-primary" id="open-ticket-submit">{{ 'Request'|trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block js %}
    <script type="text/javascript">
        document.addEventListener("DOMContentLoaded", () => {

            const cancelRequestForm = document.getElementById('cancel-request-form');
            const upgradeRequestForm = document.getElementById('upgrade-request-form');
            const openTicketForm = document.getElementById('open-ticket-form');

            cancelRequestForm.addEventListener('submit', (e) => {
                e.preventDefault();
                API.client.post('support/ticket_create',
                    new FormData(cancelRequestForm).serializeObject(),
                    () => {
                        FOSSBilling.message('Service cancellation request received');
                        const cancelRequestModal = bootstrap.Modal.getInstance(document.getElementById('cancel-request-modal'))
                        cancelRequestModal.hide();
                    },
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error')
                )
            });

            upgradeRequestForm.addEventListener('submit', (e) => {
                e.preventDefault();
                API.client.post('support/ticket_create',
                    new FormData(upgradeRequestForm).serializeObject(),
                    () => {
                        FOSSBilling.message('Service upgrade request received');
                        const upgradeRequestModal = bootstrap.Modal.getInstance(document.getElementById('upgrade-request-modal'))
                        upgradeRequestModal.hide();
                    },
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error')
                )
            });

            openTicketForm.addEventListener('submit', (e) => {
                e.preventDefault();
                API.client.post('support/ticket_create',
                    new FormData(openTicketForm).serializeObject(),
                    () => {
                        FOSSBilling.message('Ticket was submitted. If you want to track conversation please go to support section');
                        let openTicketModal = bootstrap.Modal.getInstance(document.getElementById('open-ticket-modal'));
                        openTicketModal.hide();
                    },
                    (res) => FOSSBilling.message(`${res.message} (${res.code})`, 'error')
                )
            });

            const renewalButton = document.getElementById('renewal-button');
            if (renewalButton) {
                renewalButton.addEventListener('click', function (event) {
                    event.preventDefault();

                    if (confirm("This will generate new invoice. Are you sure you want to continue?")) {
                        API.client.post('invoice/renewal_invoice', { order_id: {{ order.id }} },
                            (result) => {
                                window.location = "{{ 'invoice'|link }}" + '/' + result;
                            });
                    }
                });
            }

        });
    </script>
{% endblock %}
